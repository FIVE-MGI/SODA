# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the SODA desktop app. Builds on Windows and macOS from one file.

The same recipe as FIVE Atlas (FiveAtlas.spec), adapted to SODA:

* One-FOLDER build, not --onefile: onefile re-extracts several hundred MB to %TEMP% on every
  launch, and batch.py starts one process per dataset, so it would pay that on every dataset.
* web/SpatialViewer is copied WHOLE (as plain .py sources, the page, markers/) to
  _internal/soda/, minus the private files (config.js, logos/, .password, keys). SODA's own
  modules are then taken back OUT of the bytecode archive, so they are imported from those
  sources: prepare.py, batch.py and deid.py run exactly as from a checkout, Path(__file__)
  finds markers/, and batch.py's per-dataset processes find prepare.py on disk.
* The third-party libraries are found by analysing those same modules (hiddenimports below),
  so a new import in web/SpatialViewer is picked up without editing this file.
* umap-learn and pynndescent are shipped as .py source too: numba's cache=True needs a real
  source file next to each jitted function.

Build with app/build_release.ps1 (Windows) or app/build_release_mac.sh (macOS).
PyInstaller cannot cross-compile: build on the OS and CPU you ship to.
"""
import os
import sys
from pathlib import Path

from PyInstaller.utils.hooks import collect_dynamic_libs, collect_submodules

APP_DIR = Path(SPECPATH).resolve()
REPO = APP_DIR.parent
SODA = REPO / "web" / "SpatialViewer"
MACOS = sys.platform == "darwin"

VERSION = os.environ.get("SODA_VERSION", "0.0.0-dev")
UPDATE_REPO = os.environ.get("SODA_UPDATE_REPO", "")
MIN_MACOS = os.environ.get("SODA_MIN_MACOS", "12.0")

# The version baked into a module the frozen app imports, so the number on the zip, in Info.plist
# and in `SODA version` is one number by construction (FiveAtlas.spec does the same).
(APP_DIR / "_buildinfo.py").write_text(
    '"""Generated by SODA.spec at build time. Do not edit, do not commit."""\n'
    f'VERSION = "{VERSION}"\n'
    f'UPDATE_REPO = "{UPDATE_REPO}"\n',
    encoding="utf-8",
)

if not (SODA / "index.html").exists():
    raise SystemExit(f"the page is missing: {SODA / 'index.html'}")

# SODA's own modules: every .py in web/SpatialViewer.
SODA_MODULES = sorted(p.stem for p in SODA.glob("*.py"))

# What goes into _internal/soda/: the page folder minus anything private or local.
_PRIVATE_NAMES = {"config.js", ".password", "sample_id_key.csv"}
_PRIVATE_DIRS = {"logos", "__pycache__", ".venv", "node_modules"}


def page_files():
    out = []
    for p in SODA.rglob("*"):
        if not p.is_file():
            continue
        rel = p.relative_to(SODA)
        if set(rel.parts[:-1]) & _PRIVATE_DIRS or p.name in _PRIVATE_NAMES or p.name.endswith("_key.csv") \
                or p.suffix == ".pyc":
            continue
        out.append((str(p), str(Path("soda") / rel.parent)))
    return out


hiddenimports = (
    SODA_MODULES
    + ["_buildinfo"]
    + collect_submodules("imagecodecs")     # codecs are loaded by name
    + collect_submodules("uvicorn")         # server.py: loop/protocol chosen at run time
    + collect_submodules("numcodecs")
    + ["sklearn.neighbors", "sklearn.decomposition", "umap", "pynndescent", "igraph", "leidenalg",
       "pyarrow.parquet", "pyarrow.csv", "pyarrow.compute", "h5py", "cryptography",
       "tkinter", "tkinter.filedialog"]
)
binaries = collect_dynamic_libs("imagecodecs")

a = Analysis(
    [str(APP_DIR / "soda_app.py")],
    pathex=[str(SODA), str(APP_DIR)],
    binaries=binaries,
    datas=page_files() + [(str(APP_DIR / "home.html"), "app")],
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=["matplotlib", "IPython", "notebook", "jupyter", "pytest", "tensorflow", "torch",
              "pandas", "bokeh", "datashader", "holoviews"],
    # numba cache=True needs the source files on disk
    module_collection_mode={"umap": "py", "pynndescent": "py"},
    noarchive=False,
    optimize=0,
)

# SODA's own modules run from _internal/soda/*.py (see the docstring), not from the archive:
# the frozen importer comes first on sys.meta_path and would otherwise shadow the sources.
_own = set(SODA_MODULES)
a.pure = [e for e in a.pure if e[0].split(".")[0] not in _own]

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="SODA",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    # Windows: a console window, as FIVE Atlas: it shows the address and any error, and closing
    # it stops SODA. macOS: a .app has no console; soda_app.py writes SODA.log instead.
    console=not MACOS,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,     # PyInstaller ad-hoc signs on arm64; build_release_mac.sh can sign properly
    entitlements_file=None,
)

coll = COLLECT(exe, a.binaries, a.datas, strip=False, upx=False, upx_exclude=[], name="SODA")

if MACOS:
    app = BUNDLE(
        coll,
        name="SODA.app",
        icon=None,
        bundle_identifier="org.fivelab.soda",
        version=VERSION,
        info_plist={
            "CFBundleName": "SODA",
            "CFBundleDisplayName": "SODA",
            "CFBundleShortVersionString": VERSION,
            "CFBundleVersion": VERSION,
            "NSHighResolutionCapable": True,
            # app/check_min_os.py checks in CI that no binary inside needs a newer macOS
            "LSMinimumSystemVersion": MIN_MACOS,
            # No Dock icon: like FIVE Atlas, SODA is a local server that opens your browser, with
            # no Cocoa event loop; a Dock icon would read "Not Responding". The home page has Quit,
            # and an idle server stops itself after 30 minutes.
            "LSUIElement": True,
            "NSHumanReadableCopyright": "FIVE lab",
        },
    )
