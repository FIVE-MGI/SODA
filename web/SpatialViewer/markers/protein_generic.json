{
  "name": "Generic tissue, protein panel",
  "note": "The default list for multiplexed immunofluorescence (Akoya / PhenoCycler-style panels) when no list is given. Written from widely used textbook markers, not copied from a marker database. A 16 µm square holds several cells, so the names describe neighbourhoods ('T-cell rich'), not single cells. A type is scored when at least 2 of its markers are on the panel (minChannels), except the types with their own 'min'. Channel names are matched ignoring case, number prefixes ('01_'), fluorophore tags ('-488', '(Opal520)') and the aliases below. For a tissue-specific list (e.g. markers/akoya_nerve.json) pass --markers.",
  "version": 1,
  "modality": "protein",
  "minChannels": 2,
  "types": [
    { "name": "Immune rich", "genes": ["CD45"], "min": 1 },
    { "name": "T-cell rich", "genes": ["CD3", "CD4", "CD8", "CD2", "CD5", "CD7"] },
    { "name": "B-cell rich", "genes": ["CD19", "CD20", "CD79a", "PAX5", "CD21"] },
    { "name": "Plasma-cell rich", "genes": ["CD138", "CD38", "IRF4"] },
    { "name": "Myeloid / macrophage rich", "genes": ["CD68", "CD163", "CD206", "CD11b", "CD11c", "CD14", "HLA-DR"] },
    { "name": "NK rich", "genes": ["CD56", "CD16", "NKp46"] },
    { "name": "Neutrophil rich", "genes": ["CD15", "MPO", "CD66b"] },
    { "name": "Vascular", "genes": ["CD31", "CD34", "vWF", "ERG"] },
    { "name": "Lymphatic", "genes": ["Podoplanin", "LYVE1", "PROX1"], "min": 1 },
    { "name": "Smooth muscle / pericyte", "genes": ["aSMA", "Desmin", "CD146"] },
    { "name": "Epithelial", "genes": ["panCK", "E-cadherin", "EpCAM", "CK8", "CK18"] },
    { "name": "Neural / glial", "genes": ["NF-L", "NF-H", "TUBB3", "PGP9.5", "S100", "GFAP", "SOX10", "MBP", "MPZ"] },
    { "name": "Stromal / fibroblast", "genes": ["CD90", "Vimentin", "PDGFRA", "Collagen I", "FAP"] },
    { "name": "Proliferating", "genes": ["Ki67", "PCNA"], "min": 1 }
  ],
  "aliases": {
    "CD45": ["PTPRC"],
    "CD3": ["CD3e", "CD3E", "CD3d"],
    "CD20": ["MS4A1"],
    "CD138": ["SDC1", "Syndecan-1"],
    "CD56": ["NCAM1", "NCAM"],
    "CD16": ["FCGR3A"],
    "NKp46": ["NCR1"],
    "CD15": ["FUT4"],
    "CD66b": ["CEACAM8"],
    "CD31": ["PECAM1", "PECAM-1"],
    "vWF": ["von Willebrand Factor", "VWF"],
    "Podoplanin": ["PDPN", "D2-40"],
    "aSMA": ["SMA", "alpha-SMA", "ACTA2", "Actin alpha 2"],
    "CD146": ["MCAM"],
    "panCK": ["Pan-Cytokeratin", "Pan-CK", "Cytokeratin"],
    "E-cadherin": ["ECAD", "CDH1"],
    "EpCAM": ["CD326"],
    "CK8": ["KRT8"],
    "CK18": ["KRT18"],
    "NF-L": ["NFL", "NEFL", "Neurofilament L", "Neurofilament"],
    "NF-H": ["NFH", "NEFH"],
    "TUBB3": ["beta-III-tubulin", "Tuj1"],
    "PGP9.5": ["UCHL1"],
    "S100": ["S100B"],
    "CD90": ["THY1", "Thy-1"],
    "Collagen I": ["COL1A1", "Collagen-1", "COL1"],
    "Ki67": ["MKI67", "Ki-67"],
    "HLA-DR": ["MHC-II", "MHCII"],
    "CD206": ["MRC1"],
    "CD11b": ["ITGAM"],
    "CD11c": ["ITGAX"]
  }
}
